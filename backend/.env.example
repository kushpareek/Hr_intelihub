# Backend Environment Variables Example
# Copy this file to .env and fill in your actual values.

# Server Port
PORT=3001

# PostgreSQL Database Connection
DB_USER=your_db_user
DB_HOST=localhost
DB_DATABASE=hr_intellihub_db
DB_PASSWORD=your_db_password
DB_PORT=5432

# JSON Web Token
JWT_SECRET=generate_a_strong_random_secret_key_for_jwt
JWT_EXPIRES_IN=1h

# Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# CORS Origin (Frontend URL)
# For development, this is typically your frontend dev server URL.
# For production, set this to your deployed frontend's domain.
CORS_ORIGIN=http://localhost:5173
